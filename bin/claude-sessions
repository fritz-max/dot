#!/usr/bin/env python3
"""Pick any Claude Code session on this machine with fzf and resume it in a zellij session in its own directory.

The top entry (or ctrl-n) starts a new Claude session in a git worktree that you pick instead.

Outside zellij it attaches to (or creates) a session named after the directory, title and session id.
Inside zellij it opens a new tab instead, since zellij cannot nest or switch sessions from the CLI.

Usage: claude-sessions [fzf query]
       claude-sessions --new [fzf query]
"""

import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

PROJECTS = Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude")) / "projects"
CACHE = Path.home() / ".cache" / "claude-sessions.json"
HOME = str(Path.home())
LAYOUTS = Path.home() / ".cache" / "claude-sessions-layouts"
CLAUDE = Path.home() / "code" / "bin" / "claude"
MAIN_REPO = Path.home() / "code"
NEW = "__new__"


def prompt_text(rec):
    content = rec.get("message", {}).get("content")
    if isinstance(content, list):
        content = " ".join(c.get("text", "") for c in content if c.get("type") == "text")
    if not isinstance(content, str):
        return None
    content = " ".join(content.split())
    if not content or content.startswith(("<local-command", "<system-reminder", "<task-notification")):
        return None
    if content.startswith("<command-name>"):
        content = content[len("<command-name>"):].split("</command-name>")[0]
    return content


def scan(path):
    info = {"cwd": None, "branch": None, "start": None, "title": None, "ai_title": None,
            "pr": None, "prompts": []}
    with open(path, "rb") as f:
        for raw in f:
            # Substring checks first: most lines are large API payloads we never need to parse.
            if raw.startswith(b'{"parentUuid"') and b'"type":"user"' in raw[:300]:
                rec = json.loads(raw)
                if rec.get("type") != "user" or rec.get("isMeta") or rec.get("isSidechain"):
                    continue
                if info["cwd"] is None:
                    info["cwd"] = rec.get("cwd")
                    info["start"] = rec.get("timestamp")
                info["branch"] = rec.get("gitBranch") or info["branch"]
                if isinstance(rec.get("message", {}).get("content"), list) and any(
                    c.get("type") == "tool_result" for c in rec["message"]["content"]
                ):
                    continue
                text = prompt_text(rec)
                if text:
                    info["prompts"].append(text[:300])
            elif raw.startswith(b'{"type":"custom-title"'):
                info["title"] = json.loads(raw).get("customTitle")
            elif raw.startswith(b'{"type":"ai-title"'):
                info["ai_title"] = json.loads(raw).get("aiTitle")
            elif raw.startswith(b'{"type":"pr-link"'):
                info["pr"] = json.loads(raw).get("prNumber")
    return info


def load_sessions():
    try:
        cache = json.loads(CACHE.read_text())
    except (OSError, ValueError):
        cache = {}
    sessions, fresh = [], {}
    for path in PROJECTS.glob("*/*.jsonl"):
        st = path.stat()
        key = str(path)
        entry = cache.get(key)
        if not entry or entry["mtime"] != st.st_mtime or entry["size"] != st.st_size:
            entry = {"mtime": st.st_mtime, "size": st.st_size, **scan(path)}
        fresh[key] = entry
        if entry["cwd"] and entry["prompts"]:
            sessions.append((path.stem, key, entry))
    CACHE.parent.mkdir(parents=True, exist_ok=True)
    CACHE.write_text(json.dumps(fresh))
    sessions.sort(key=lambda s: s[2]["mtime"], reverse=True)
    return sessions


def short(cwd):
    return cwd.replace(HOME, "~", 1) if cwd.startswith(HOME) else cwd


def dir_label(cwd):
    # Worktrees live at ~/worktrees/code/<name>/code; the repo dir name alone is ambiguous.
    rel = Path(cwd).relative_to(HOME) if cwd.startswith(HOME + "/") else Path(cwd)
    parts = [p for p in rel.parts if p not in ("/", "code")]
    return parts[-1] if parts else "code"


def slug(text, limit):
    out = "".join(c if c.isalnum() else "-" for c in text.lower())
    out = "-".join(w for w in out.split("-") if w)
    return out[:limit].rstrip("-")


def zellij_name(cwd, title, suffix):
    # Zellij puts the name in a socket path, so keep the whole name short.
    return "-".join(p for p in (dir_label(cwd)[:20], slug(title, 28), suffix) if p)


def write_layout(name, cwd, claude_args):
    q = json.dumps
    LAYOUTS.mkdir(parents=True, exist_ok=True)
    path = LAYOUTS / f"{name}.kdl"
    # Command panes do not run the shell's direnv hook, so load the directory's env explicitly.
    path.write_text(f"""layout {{
    default_tab_template {{
        pane size=1 borderless=true {{ plugin location="zellij:tab-bar"; }}
        children
        pane size=2 borderless=true {{ plugin location="zellij:status-bar"; }}
    }}
    tab name={q(name)} cwd={q(cwd)} focus=true {{
        pane command="direnv" cwd={q(cwd)} {{
            args "exec" {q(cwd)} {q(str(CLAUDE))} {" ".join(q(a) for a in claude_args)}
        }}
    }}
}}
""")
    return path


def preview(key):
    entry = json.loads(CACHE.read_text())[key]
    print(f"dir:     {short(entry['cwd'])}" + ("" if os.path.isdir(entry["cwd"]) else "  (MISSING)"))
    print(f"branch:  {entry['branch'] or '-'}")
    print(f"started: {entry['start'] or '-'}")
    print(f"updated: {time.strftime('%Y-%m-%d %H:%M', time.localtime(entry['mtime']))}")
    if entry["pr"]:
        print(f"PR:      #{entry['pr']}")
    print(f"prompts: {len(entry['prompts'])}\n")
    for p in entry["prompts"][:3]:
        print(f"> {p}\n")
    if len(entry["prompts"]) > 3:
        print("...\n")
        for p in entry["prompts"][-3:]:
            print(f"> {p}\n")


def worktrees():
    out = subprocess.run(["git", "-C", str(MAIN_REPO), "worktree", "list", "--porcelain"],
                         stdout=subprocess.PIPE, text=True, check=True).stdout
    trees = []
    for block in out.strip().split("\n\n"):
        fields = dict((line.split(" ", 1) + [""])[:2] for line in block.splitlines())
        path = fields["worktree"]
        if "prunable" in fields or not path.startswith(HOME + "/") or "/.cache/" in path:
            continue
        branch = fields.get("branch", "").removeprefix("refs/heads/") or f"(detached {fields.get('HEAD', '')[:10]})"
        trees.append((path, branch))
    return trees


def pick_worktree(query):
    lines = [f"{path}\t{short(path):<45}  {branch}" for path, branch in worktrees()]
    fzf = subprocess.run(
        ["fzf", "--delimiter=\t", "--with-nth=2", "--prompt=worktree> ", "--query", query,
         "--preview", "git -C {1} log --oneline --color=always -15; echo; git -C {1} status --short",
         "--preview-window=down,45%,wrap"],
        input="\n".join(lines), stdout=subprocess.PIPE, text=True,
    )
    if fzf.returncode != 0 or not fzf.stdout.strip():
        return None
    return fzf.stdout.split("\t", 1)[0]


def launch(name, cwd, claude_args):
    if not os.access(CLAUDE, os.X_OK):
        sys.exit(f"claude-sessions: {CLAUDE} is missing or not executable")
    os.chdir(cwd)
    if os.environ.get("ZELLIJ") is not None:
        layout = write_layout(name, cwd, claude_args)
        print(f"zellij: new tab {name} in the current session", file=sys.stderr)
        os.execvp("zellij", ["zellij", "action", "new-tab", "--layout", str(layout), "--name", name, "--cwd", cwd])
    existing = subprocess.run(["zellij", "list-sessions", "--short", "--no-formatting"],
                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True).stdout.split()
    if name in existing:
        print(f"zellij: attaching to {name}", file=sys.stderr)
        os.execvp("zellij", ["zellij", "attach", name])
    layout = write_layout(name, cwd, claude_args)
    print(f"zellij: new session {name} in {short(cwd)}", file=sys.stderr)
    os.execvp("zellij", ["zellij", "--session", name, "--new-session-with-layout", str(layout)])


def start_new(query=""):
    cwd = pick_worktree(query)
    if cwd is None:
        return
    launch(zellij_name(cwd, "new", time.strftime("%m%d-%H%M")), cwd, [])


def main():
    if len(sys.argv) == 3 and sys.argv[1] == "--preview":
        if sys.argv[2] == NEW:
            print("Start a new Claude session in a git worktree of your choice (also: ctrl-n).")
        else:
            preview(sys.argv[2])
        return
    for tool in ("fzf", "zellij", "direnv", "git"):
        if not shutil.which(tool):
            sys.exit(f"claude-sessions: {tool} not found on PATH")
    if sys.argv[1:2] == ["--new"]:
        start_new(" ".join(sys.argv[2:]))
        return

    lines = [f"{NEW}\t{NEW}\t+ new session in a worktree..."]
    for sid, key, e in load_sessions():
        when = time.strftime("%m-%d %H:%M", time.localtime(e["mtime"]))
        title = e["title"] or e["ai_title"] or e["prompts"][0]
        pr = f"  #{e['pr']}" if e["pr"] else ""
        lines.append(f"{sid}\t{key}\t{when}  {short(e['cwd']):<38.38}  {title[:90]}{pr}")

    fzf = subprocess.run(
        ["fzf", "--delimiter=\t", "--with-nth=3", "--no-sort", "--ansi", "--expect=ctrl-n",
         "--prompt=session> ", "--query", " ".join(sys.argv[1:]),
         "--preview", f"{sys.executable} {Path(__file__).resolve()} --preview {{2}}",
         "--preview-window=down,45%,wrap"],
        input="\n".join(lines), stdout=subprocess.PIPE, text=True,
    )
    if fzf.returncode != 0:
        return
    key_pressed, _, selection = fzf.stdout.partition("\n")
    if key_pressed == "ctrl-n":
        start_new()
        return
    if not selection.strip():
        return
    sid, key, _ = selection.rstrip("\n").split("\t", 2)
    if sid == NEW:
        start_new()
        return
    entry = json.loads(CACHE.read_text())[key]
    cwd = entry["cwd"]
    if not os.path.isdir(cwd):
        sys.exit(f"claude-sessions: {cwd} no longer exists; cannot resume {sid} there")
    title = entry["title"] or entry["ai_title"] or entry["prompts"][0]
    launch(zellij_name(cwd, title, sid[:4]), cwd, ["--resume", sid])


if __name__ == "__main__":
    main()
