#!/usr/bin/env python3
"""Pick any Claude Code session on this machine with fzf and resume it in its own directory.

Usage: claude-sessions [fzf query]
"""

import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

PROJECTS = Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude")) / "projects"
CACHE = Path.home() / ".cache" / "claude-sessions.json"
HOME = str(Path.home())


def prompt_text(rec):
    content = rec.get("message", {}).get("content")
    if isinstance(content, list):
        content = " ".join(c.get("text", "") for c in content if c.get("type") == "text")
    if not isinstance(content, str):
        return None
    content = " ".join(content.split())
    if not content or content.startswith(("<local-command", "<system-reminder", "<task-notification")):
        return None
    if content.startswith("<command-name>"):
        content = content[len("<command-name>"):].split("</command-name>")[0]
    return content


def scan(path):
    info = {"cwd": None, "branch": None, "start": None, "title": None, "ai_title": None,
            "pr": None, "prompts": []}
    with open(path, "rb") as f:
        for raw in f:
            # Substring checks first: most lines are large API payloads we never need to parse.
            if raw.startswith(b'{"parentUuid"') and b'"type":"user"' in raw[:300]:
                rec = json.loads(raw)
                if rec.get("type") != "user" or rec.get("isMeta") or rec.get("isSidechain"):
                    continue
                if info["cwd"] is None:
                    info["cwd"] = rec.get("cwd")
                    info["start"] = rec.get("timestamp")
                info["branch"] = rec.get("gitBranch") or info["branch"]
                if isinstance(rec.get("message", {}).get("content"), list) and any(
                    c.get("type") == "tool_result" for c in rec["message"]["content"]
                ):
                    continue
                text = prompt_text(rec)
                if text:
                    info["prompts"].append(text[:300])
            elif raw.startswith(b'{"type":"custom-title"'):
                info["title"] = json.loads(raw).get("customTitle")
            elif raw.startswith(b'{"type":"ai-title"'):
                info["ai_title"] = json.loads(raw).get("aiTitle")
            elif raw.startswith(b'{"type":"pr-link"'):
                info["pr"] = json.loads(raw).get("prNumber")
    return info


def load_sessions():
    try:
        cache = json.loads(CACHE.read_text())
    except (OSError, ValueError):
        cache = {}
    sessions, fresh = [], {}
    for path in PROJECTS.glob("*/*.jsonl"):
        st = path.stat()
        key = str(path)
        entry = cache.get(key)
        if not entry or entry["mtime"] != st.st_mtime or entry["size"] != st.st_size:
            entry = {"mtime": st.st_mtime, "size": st.st_size, **scan(path)}
        fresh[key] = entry
        if entry["cwd"] and entry["prompts"]:
            sessions.append((path.stem, key, entry))
    CACHE.parent.mkdir(parents=True, exist_ok=True)
    CACHE.write_text(json.dumps(fresh))
    sessions.sort(key=lambda s: s[2]["mtime"], reverse=True)
    return sessions


def short(cwd):
    return cwd.replace(HOME, "~", 1) if cwd.startswith(HOME) else cwd


def preview(key):
    entry = json.loads(CACHE.read_text())[key]
    print(f"dir:     {short(entry['cwd'])}" + ("" if os.path.isdir(entry["cwd"]) else "  (MISSING)"))
    print(f"branch:  {entry['branch'] or '-'}")
    print(f"started: {entry['start'] or '-'}")
    print(f"updated: {time.strftime('%Y-%m-%d %H:%M', time.localtime(entry['mtime']))}")
    if entry["pr"]:
        print(f"PR:      #{entry['pr']}")
    print(f"prompts: {len(entry['prompts'])}\n")
    for p in entry["prompts"][:3]:
        print(f"> {p}\n")
    if len(entry["prompts"]) > 3:
        print("...\n")
        for p in entry["prompts"][-3:]:
            print(f"> {p}\n")


def main():
    if len(sys.argv) == 3 and sys.argv[1] == "--preview":
        preview(sys.argv[2])
        return
    if not shutil.which("fzf"):
        sys.exit("claude-sessions: fzf not found on PATH")

    lines = []
    for sid, key, e in load_sessions():
        when = time.strftime("%m-%d %H:%M", time.localtime(e["mtime"]))
        title = e["title"] or e["ai_title"] or e["prompts"][0]
        pr = f"  #{e['pr']}" if e["pr"] else ""
        lines.append(f"{sid}\t{key}\t{when}  {short(e['cwd']):<38.38}  {title[:90]}{pr}")

    fzf = subprocess.run(
        ["fzf", "--delimiter=\t", "--with-nth=3", "--no-sort", "--ansi",
         "--prompt=session> ", "--query", " ".join(sys.argv[1:]),
         "--preview", f"{sys.executable} {Path(__file__).resolve()} --preview {{2}}",
         "--preview-window=down,45%,wrap"],
        input="\n".join(lines), stdout=subprocess.PIPE, text=True,
    )
    if fzf.returncode != 0 or not fzf.stdout.strip():
        return
    sid, key, _ = fzf.stdout.rstrip("\n").split("\t", 2)
    cwd = json.loads(CACHE.read_text())[key]["cwd"]
    if not os.path.isdir(cwd):
        sys.exit(f"claude-sessions: {cwd} no longer exists; cannot resume {sid} there")
    print(f"cd {short(cwd)} && claude --resume {sid}", file=sys.stderr)
    os.chdir(cwd)
    os.execvp("claude", ["claude", "--resume", sid])


if __name__ == "__main__":
    main()
